# Copy to .env (never commit .env).  Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEYS=change-me-generate-a-long-random-key
PORT=8000

# Optional tuning
# RAG_RATE_LIMIT_PER_MIN=60
# RAG_MAX_UPLOAD_MB=10
# RAG_CACHE_TTL_S=300
# RAG_QUEUE_WORKERS=2

# Optional neural backends (build the image with `pip install .[ml]` / `.[llm]` first)
# RAG_EMBEDDER=sentence-transformers
# RAG_RERANKER=cross-encoder
# RAG_GENERATOR=anthropic
# ANTHROPIC_API_KEY=
